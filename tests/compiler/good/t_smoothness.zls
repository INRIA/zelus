let hybrid f1 z x =
  let rec y = x and o = last y in
                    present z -> o else 0 

let hybrid f2 x =
  let rec der o = o +. x +. 1. init 0. in o

let hybrid bouncing (x0, x'0, g) =
  let rec der x' = -. g init x'0 reset up(-. x) -> last x''_
      and x'_ = -0.8 *. last x'
      and init x''_ = 0.0
      and x''_ = x'_ +. 0.0 -. 0.0 and der x = x' init x0 in
  (x, x')

