(* verification of the typing for const and static annotations *)
let node seq (const f) (const g) x = f x + g x

let node main4 x = seq (fun x -> x + 1) (fun y -> y + 2) x

let const f (const g) x = g x

let main1 x z = f (fun x -> x+1) z

let const g1 x = x + 1

let main2 x z = f g1 z

let const g2 x = x + 1

let const node lift (const f) x = f x 

let f1 (static x) () =
  let static g y = y, x in
  g

let f2 (const x) () =
  let const g = x in
  g

let f3 x () =
  let static g y x = y + x in
  g
