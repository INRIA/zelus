let f(x:[1]_) returns (o:[3]_)
  local y in
  do y = [|1|] ++ x and o = y ++ [|3|] done

let g<<n>>(x:[n]_) returns (o:[3]_)
  local y in
  do y = [|1|] ++ x and o = y ++ [|3|] done

let g1<<n>>(x:[n]_) returns (o)
  forward<<n>> (xi in x) returns (oi out o)
    do oi = xi done

let rec f<<n>> : unit -> [n]int = fun () ->
  match size n with
  | 0 -> [||]
  | _ -> [|0|] ++ f<<n-1>>()
