(* Modeling of bounded LTL *)

(* given a temporal formula [f], [first f] checks that *)
(* [f] is true at the very first instant *)
let const node first (const f) x returns o
  automaton
  | First -> do o = run f x then Second
  | Second -> do o = true done

(* [next f] is true after the very first instant, strictly *)
let const node next (const f) x returns o
  automaton
  | Await -> do o = true then Always
  | Always -> do o = run f x done

(* a property [f] must be true at every instant *)
(* the following resets it at every instant *)
let const node resart (const f) x =
  reset run f x every true

(* [or], [and], [not] operations *)
let const node or_ (const f) (const g) x = (run f x) || (run g x)

let const node and_ (const f) (const g) x = (run f x) && (run g x)

let const node not_ (const f) x = not (run f x)

(* bounded until. [until_<<n>> f g x] means that [f x] is true until [g x] *)
(* is true but it waits at most [n] instants *)
let const rec node until_<<n>> (const f) (const g) x =
  match size n with
  | 0 -> true
  | _ -> or_ f (next (until_<<n-1>> f g)) x

(* simple lifting and wiring primitives *)
let const node lift (const f) x = f x 
let const fst (x, y) = x
let const snd (x, y) = y

let const greater_x (x,y,z) = x >= 0
let const lesser_y (x,y,z) = y <= 0
let const greater_z (x,y,z) = z >= 2

(* Example : \(x,y). (x >= 0) until[4] ((y <= 0) until[5] (z >= 2)) *)
(* is represented as *)
let node example (x,y,z) =
  until_<<4>>
    (lift (fun (x, y, z) -> x >= 0))
    (until_<<5>>
       (lift (fun (x, y, z) -> y <= 0))
       (lift (fun (x, y, z) -> z >= 2)))
    (x,y,z)