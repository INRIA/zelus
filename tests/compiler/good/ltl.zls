(* Modeling of bounded LTL *)
let const node always (const f) x =
  reset run f x every true

let const node once (const f) x returns o
  automaton
  | First -> do o = run f x then Second
  | Second -> do o = true done

let const node next (const f) x returns o
  automaton
  | Await -> do o = true then Always
  | Always -> do o = run f x done

let const node or_ (const f) (const g) x = (run f x) || (run g x)

let const node and_ (const f) (const g) x = (run f x) && (run g x)

let const rec node until_<<n>> (const f) (const g) x =
  match size n with
  | 0 -> true
  | _ -> or_ f (next (until_<<n-1>> f g)) x


let const node lift (const f) x = f x 

let const greater (x,y,z) = x >= 0

(* Example : \(x,y). (x >= 0) until[4] ((y <= 0) until[5] (z >= 2)) *)
(* is represented as *)
let node example (x,y,z) =
  until_<<4>>
    (lift greater)
    (until_<<5>>
       (lift (fun (x,y,z) -> y <= 0))
       (lift (fun (x,y,z) -> z >= 2)))
    (x,y,z)