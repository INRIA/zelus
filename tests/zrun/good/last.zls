(* A use of the [as ...] notation in a for loop to name the currently *)
(* constructed array *)

(* In this example, an output array [o] is computed sequentially, *)
(* from left to right, and the [i-th] element used the *)
(* previously constructed slice o[0..i] *)
(* input: an array x = [|x(0);...;x(n-1)|]. *)
(* output: an array o = [|o(0);...;o(n-1)|] where *)
(* o(i) = sigma_{k = 0}{i-1} o(k) * x(k) *)
let acc_very_slow<<n>>(x:[n]_) returns (o)
  forward<<n>>[i](xi in x) returns (oi out o as o_)
    do oi = forward(i)[k] returns (sum init 0)
              do sum = last sum + (last o_).(k) * x.(k) done
    done

let main() =
  let x = [|1;2;3;4;5|] in
  let o = acc_very_slow<<5>>(x) in
  o
  