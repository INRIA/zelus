let node counter(xi) returns (o)
  o = (0 fby o) + xi

let node sum<<n>>(x:[n]_) returns (o)
  forward<<n>>[i] returns (o) do
    o = counter(x.(i))
  done

let f () =
  forward(10) (i in 0 to 9) returns (o)
    do o = 0 -> pre o + i done

let node make1<<n>>() = 
  forward<<n>> (i in 0 to n-1) returns ([|o|]) do o = i done

let make2<<n>>() = 
  forward<<n>> (i in 0 to n-1) returns ([|o|]) do o = i done

let make3<<n>> = 
  forward<<n>> returns ([|o|]) 
     local i init 0 do o = last i and i = last i + 1 done

let node main() returns (s)
  let o = [| 1; 2; 3; 4 |] in
  do s = sum<<4>>(o) done

let node main1() returns ()
  assert (f() = sum<<4>>(make1<<4>>()))

let node main2() returns (s1, s2, s3)
  let o = [| 1; 2; 3; 4 |] in
  do s1 = sum<<4>>(make1<<4>>())
  and s2 = sum<<4>>(make2<<4>>())
  and s3 = sum<<4>>(make3<<4>>)
  and assert (s1 = s2 && s1 = s3)
  done

