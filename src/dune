(include_subdirs unqualified)

; the Zelus compiler
(executable
 (name zeluc)
 (modes
  (byte exe))
 (libraries unix zelus_global zelus_parsing zelus_zrun zelus_compiler)
 (preprocess
  (pps ppx_deriving.show))
 (modules zeluc)
 (promote
  (until-clean)
  (into %{project_root}/bin)))

; the ZRun interpreter
(executable
 (name zrun)
 (modes
  (byte exe))
 (libraries unix zelus_global zelus_parsing zelus_zrun)
 (preprocess
  (pps ppx_deriving.show))
 (modules zrun)
 (promote
  (until-clean)
  (into %{project_root}/bin)))

; Compiler organisation
;
; parser/
;   location.ml ; position in the source file for error messages
;    lexer.mll parser.mll ; lexer/parser;
;    parsetree.ml ; abstract syntax tree after parsing
;
; global/ 
;  config.ml misc.ml ; general configuration and common global variables
;  ident.ml: identifiers, environments
;  lident.ml ; long names (global identifers), environments
;  defnames.ml ; names defined by an equation
;  util.ml ; useful functions that are not in Ocaml standard lib
;  zelus.ml ; the ast of Zelus
;  write.ml ; computes defined variables for equations
;  scoping.ml ; translate the ast after parsing into Zelus ast; unique idents
;  pp_tools.ml ; pretty printer tools
;  printer.ml ; printer for the Zelus ast
;  noinfo ; no type information attached to patterns, expressions and equations
;
;  graph.ml ; acyclic graph manipulation
;  parseq ; a data-structure to represent parallel and sequential composition
;  aux.ml ; auxiliary functions for building Zelus terms
;
; typdefs/
; defcaus.ml ; causality types
; deftypes.ml ; data types
; initial.ml ; the initial module
; pinit.ml ; print initialisation types
; typinfo.ml ; type information attached to Zelus terms
; definit.ml ; initialization types
; genames.ml ; generation of fresh names
; modules.ml ; the organisation of modules (impl. .zls and interfaces .zli
; ptypes.ml ; print types
; defsizes.ml ; definition of sizes
; global.ml ; representation of global names
; pcaus.ml ; print causality types;
; ptypinfo.ml ; print type information

; typing/
;  sizes ; decision algorithm for equality between sizes
;  types ; type manipulation and unification between types
;  interface ; interfaces (declarations, translation between representations)
;  kind ; kinds for expressions (stateful, combinational, continuous, etc.)
;  total ; check totality of pattern matching
;  patternsig ; check totality of pattern matching
;  matching ; check totality of pattern matching
;  typerrors ; type errors;
;  typing ; the main typing engine

; analysis/
;
  causality/
;   tcausal ; type manipulation and unification between types for causality
;   causality ; causality inference
;    )
; initialization/
;   tinit ;  type manipulation and unification between types for initialisation
;   initialization ; initialization inference

; rewriting steps
;    cost ; a cost function used to decide which function call to inline
;    unsafe ; is an expression/equation unsafe
;    mapfold ; generic mapfold
;    markfunctions ; mark function calls to be inlined
;    noassert ; remove assertions
;    const ; compile time evaluation of constants
;    sizerec ; specialize recursive size functions
;    inline ; inlining of function calls
;    automata ; rewrite automata into match/reset
;    present ; rewrite present into match
;    lastinpatterns ; remove last in patterns
;    copylast ; add copies [lx = last*x] for [last x] when [x] is local
;             ; all variables in patterns must be value (remove last)
;    der ; remove the initialization and reset part of a derivative equation
;    exp2eq ; translate match and reset expressions into their equational form
;    returns ; rewrite [returns (p) eq]
;    complete ; complete equations with [der x = 0.0]
;    default ; translate blocks into let/rec (propagate
;            ; the default and initialisation values)
;    pre ; rewrite fby/fby into (init/last)
;    period ; translate periods into horizons
;    encore ; add horizons [horizon h = 0.0] for zero-crossings
;    disc ; compile the operation disc with an horizon
;    init ; rewrite -> 
;    shared ; normalise equations to shared variables into [x = ...]
;    letin ; un-nesting of let/in and blocks
;    reset ; distribute the reset over equations
;    distribute ; distribution of tuples and records
;    ; zopt ; sharing of zero-crossings
;    copy ; remove of copy variables
;    ; cse ; common sub-expression elimination
;    vars ; read variables
;    deadcode ; deadcode removal
;    dependences ; data-dependences between equations
;    control ; fusion of control dependences
;    schedule ; static scheduling
;    set_sorts ; sets the sort for variables in the environment
;    rewrite ; compose rewriting steps

; generation of sequential code
;    obc; the AST for representing Mealy machines
;    oaux; auxiliary functions for building terms
;    oprinter; the printer
;    ocamlprinter; print OCaml code
;    translate; translate into sequential code
;    inout; add extra code for in-place modification of the continuous
;           state vector and zero-crossing vector

; The compiler
;   compiler; the compiler
;   simulator; the generation of the main function
